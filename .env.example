# =========================================================================
# LE BADIL CONCIERGERIE DAKAR — CONFIGURATION D'ENVIRONNEMENT (EXEMPLE)
# =========================================================================

# Port d'écoute (par défaut: 8080)
PORT=8080

# URL de production (votre domaine ou URL Vercel)
SITE_URL=https://votre-projet.vercel.app
PUBLIC_URL=https://votre-projet.vercel.app

# Passerelle PayTech Sénégal
# (Clés disponibles sur https://paytech.sn/app/settings/api)
PAYTECH_API_KEY=votre_cle_api_paytech
PAYTECH_API_SECRET=votre_cle_secrete_paytech
PAYTECH_ENV=test # passer à 'prod' dès activation du compte marchand

# Plateforme d'emails Brevo (Sendinblue)
# (Clé disponible sur https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=xkeysib-votre_cle_api_brevo
BREVO_SENDER_EMAIL=contact@lebadilconciergerie.sn
BREVO_SENDER_NAME=Le BADIL Conciergerie Dakar
WHATSAPP_PHONE=221770000000

# Espace Administration Sécurisé (/admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=LeBadil2026!
ADMIN_SESSION_SECRET=badil_secret_session_production_2026
